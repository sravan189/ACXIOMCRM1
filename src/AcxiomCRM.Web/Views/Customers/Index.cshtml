@using AcxiomCRM.Web.Helpers
@model PaginatedList<Customer>
@{
    ViewData["Title"] = "Customers";
    var search = (string?)ViewBag.Search;
    var status = (CustomerStatus?)ViewBag.Status;
    var sortBy = (string?)ViewBag.SortBy ?? "created";
    var sortDir = (string?)ViewBag.SortDir ?? "desc";
    string ToggleDir(string col) => sortBy == col && sortDir == "asc" ? "desc" : "asc";
    string Arrow(string col) => sortBy == col ? (sortDir == "asc" ? " ▲" : " ▼") : "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Customer</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="search" value="@search" class="form-control" placeholder="Search name, email, phone, company..." />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<CustomerStatus>())
            {
                <option value="@s" selected="@(status == s ? "selected" : null)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Code</th>
                <th>
                    <a asp-action="Index" asp-route-search="@search" asp-route-status="@status"
                       asp-route-sortBy="name" asp-route-sortDir="@ToggleDir("name")" class="text-decoration-none">Name@(Arrow("name"))</a>
                </th>
                <th>Company</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>
                    <a asp-action="Index" asp-route-search="@search" asp-route-status="@status"
                       asp-route-sortBy="created" asp-route-sortDir="@ToggleDir("created")" class="text-decoration-none">Created@(Arrow("created"))</a>
                </th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="text-nowrap"><code>@c.CustomerCode</code></td>
                    <td><a asp-action="Details" asp-route-id="@c.CustomerId">@c.CustomerName</a></td>
                    <td>@(c.CompanyName ?? "—")</td>
                    <td>@c.Email</td>
                    <td class="text-nowrap">@c.Phone</td>
                    <td>
                        <span class="badge @(c.Status == CustomerStatus.Active ? "bg-success" : "bg-secondary")">@c.Status</span>
                    </td>
                    <td class="text-nowrap">@c.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-danger">Deactivate</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info">No customers found.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">
            Showing @((Model.PageIndex - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount)) of @Model.TotalCount
        </span>
        <nav aria-label="Customers pages">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)"
                       asp-route-search="@search" asp-route-status="@status"
                       asp-route-sortBy="@sortBy" asp-route-sortDir="@sortDir">Previous</a>
                </li>
                @for (var p = Math.Max(1, Model.PageIndex - 2); p <= Math.Min(Model.TotalPages, Model.PageIndex + 2); p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p"
                           asp-route-search="@search" asp-route-status="@status"
                           asp-route-sortBy="@sortBy" asp-route-sortDir="@sortDir">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)"
                       asp-route-search="@search" asp-route-status="@status"
                       asp-route-sortBy="@sortBy" asp-route-sortDir="@sortDir">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}
