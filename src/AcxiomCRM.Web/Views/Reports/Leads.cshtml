@using AcxiomCRM.Web.Models
@using AcxiomCRM.Web.Services
@using AcxiomCRM.Web.ViewModels.Shared
@model PagedResult<LeadReportRow>
@{
    ViewData["Title"] = "Lead Report";
    var f = (LeadReportFilters)(ViewBag.Filters ?? new LeadReportFilters());
    var sortBy = f.SortBy ?? "created";
    var sortDir = f.SortDir ?? "desc";
    var showAssigneeFilter = (bool)(ViewBag.ShowAssigneeFilter ?? false);
    var assigneeUsers = (List<ApplicationUser>?)(ViewBag.AssigneeUsers);
    string ToggleDir(string col) => sortBy == col && sortDir == "asc" ? "desc" : "asc";
    string Arrow(string col) => sortBy == col ? (sortDir == "asc" ? " ▲" : " ▼") : "";
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";
    Dictionary<string, string?> Route(string? sb, string? sd) => new()
    {
        ["status"] = f.Status?.ToString(), ["assignedTo"] = f.AssignedToId,
        ["from"] = D(f.From), ["to"] = D(f.To), ["search"] = f.Search,
        ["sortBy"] = sb, ["sortDir"] = sd
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Lead Report</h1>
    <a asp-action="Leads" asp-all-route-data="@(Route(sortBy, sortDir))" asp-route-format="csv"
       class="btn btn-outline-success btn-sm"><i class="bi bi-download"></i> Export CSV</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Leads" class="row g-2 mb-3">
    <div class="col-md-3">
        <input name="search" value="@f.Search" class="form-control" placeholder="Search name, code, company..." />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<LeadStatus>())
            {
                <option value="@s" selected="@(f.Status == s ? "selected" : null)">@s</option>
            }
        </select>
    </div>
    @if (showAssigneeFilter && assigneeUsers is not null)
    {
        <div class="col-md-2">
            <select name="assignedTo" class="form-select">
                <option value="">All assignees</option>
                @foreach (var u in assigneeUsers)
                {
                    <option value="@u.Id" selected="@(f.AssignedToId == u.Id ? "selected" : null)">@u.FullName</option>
                }
            </select>
        </div>
    }
    <div class="col-md-2">
        <input type="date" name="from" value="@D(f.From)" class="form-control" title="From" />
    </div>
    <div class="col-md-2">
        <input type="date" name="to" value="@D(f.To)" class="form-control" title="To" />
    </div>
    <div class="col-md-1 d-flex gap-1">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Leads" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th><a asp-action="Leads" asp-all-route-data="@(Route("code", ToggleDir("code")))" class="text-decoration-none">Code@(Arrow("code"))</a></th>
                <th><a asp-action="Leads" asp-all-route-data="@(Route("name", ToggleDir("name")))" class="text-decoration-none">Name@(Arrow("name"))</a></th>
                <th><a asp-action="Leads" asp-all-route-data="@(Route("company", ToggleDir("company")))" class="text-decoration-none">Company@(Arrow("company"))</a></th>
                <th>Source</th>
                <th><a asp-action="Leads" asp-all-route-data="@(Route("status", ToggleDir("status")))" class="text-decoration-none">Status@(Arrow("status"))</a></th>
                <th><a asp-action="Leads" asp-all-route-data="@(Route("value", ToggleDir("value")))" class="text-decoration-none">Expected Value@(Arrow("value"))</a></th>
                <th>Assigned To</th>
                <th><a asp-action="Leads" asp-all-route-data="@(Route("created", ToggleDir("created")))" class="text-decoration-none">Created@(Arrow("created"))</a></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No leads match the current filters.</td></tr>
            }
            @foreach (var l in Model.Items)
            {
                <tr>
                    <td class="text-nowrap"><code>@l.LeadCode</code></td>
                    <td>@l.LeadName</td>
                    <td>@(l.CompanyName ?? "-")</td>
                    <td>@(l.Source ?? "-")</td>
                    <td><span class="badge bg-secondary">@l.Status</span></td>
                    <td class="text-nowrap">₹@l.ExpectedValue.ToString("N2")</td>
                    <td>@(l.AssignedToName ?? "-")</td>
                    <td class="text-nowrap">@l.CreatedDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel
{
    PageIndex = Model.Page,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "Leads",
    Controller = "Reports",
    RouteValues = Route(sortBy, sortDir)
})
