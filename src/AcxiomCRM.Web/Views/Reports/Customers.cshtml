@using AcxiomCRM.Web.Models
@using AcxiomCRM.Web.Services
@using AcxiomCRM.Web.ViewModels.Shared
@model PagedResult<CustomerReportRow>
@{
    ViewData["Title"] = "Customer Report";
    var f = (CustomerReportFilters)(ViewBag.Filters ?? new CustomerReportFilters());
    var sortBy = f.SortBy ?? "created";
    var sortDir = f.SortDir ?? "desc";
    string ToggleDir(string col) => sortBy == col && sortDir == "asc" ? "desc" : "asc";
    string Arrow(string col) => sortBy == col ? (sortDir == "asc" ? " ▲" : " ▼") : "";
    Dictionary<string, string?> Route(string? sb, string? sd) => new()
    {
        ["status"] = f.Status?.ToString(), ["search"] = f.Search,
        ["sortBy"] = sb, ["sortDir"] = sd
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customer Report</h1>
    <a asp-action="Customers" asp-route-status="@f.Status" asp-route-search="@f.Search"
       asp-route-sortBy="@sortBy" asp-route-sortDir="@sortDir" asp-route-format="csv"
       class="btn btn-outline-success btn-sm"><i class="bi bi-download"></i> Export CSV</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Customers" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="search" value="@f.Search" class="form-control" placeholder="Search name, code, company, email, phone..." />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<CustomerStatus>())
            {
                <option value="@s" selected="@(f.Status == s ? "selected" : null)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Customers" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th><a asp-action="Customers" asp-all-route-data="@(Route("code", ToggleDir("code")))" class="text-decoration-none">Code@(Arrow("code"))</a></th>
                <th><a asp-action="Customers" asp-all-route-data="@(Route("name", ToggleDir("name")))" class="text-decoration-none">Name@(Arrow("name"))</a></th>
                <th><a asp-action="Customers" asp-all-route-data="@(Route("company", ToggleDir("company")))" class="text-decoration-none">Company@(Arrow("company"))</a></th>
                <th>Email</th>
                <th>Phone</th>
                <th><a asp-action="Customers" asp-all-route-data="@(Route("status", ToggleDir("status")))" class="text-decoration-none">Status@(Arrow("status"))</a></th>
                <th>Assigned To</th>
                <th><a asp-action="Customers" asp-all-route-data="@(Route("created", ToggleDir("created")))" class="text-decoration-none">Created@(Arrow("created"))</a></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No customers match the current filters.</td></tr>
            }
            @foreach (var c in Model.Items)
            {
                <tr>
                    <td class="text-nowrap"><code>@c.CustomerCode</code></td>
                    <td>@c.CustomerName</td>
                    <td>@(c.CompanyName ?? "-")</td>
                    <td class="text-break">@c.Email</td>
                    <td class="text-nowrap">@c.Phone</td>
                    <td><span class="badge @(c.Status == CustomerStatus.Active ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                    <td>@(c.AssignedToName ?? "-")</td>
                    <td class="text-nowrap">@c.CreatedDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel
{
    PageIndex = Model.Page,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "Customers",
    Controller = "Reports",
    RouteValues = Route(sortBy, sortDir)
})
