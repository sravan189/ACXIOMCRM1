@using AcxiomCRM.Web.Models
@using AcxiomCRM.Web.Services
@using AcxiomCRM.Web.ViewModels.Shared
@model PagedResult<OpportunityReportRow>
@{
    ViewData["Title"] = "Opportunity Report";
    var f = (OpportunityReportFilters)(ViewBag.Filters ?? new OpportunityReportFilters());
    var sortBy = f.SortBy ?? "created";
    var sortDir = f.SortDir ?? "desc";
    string ToggleDir(string col) => sortBy == col && sortDir == "asc" ? "desc" : "asc";
    string Arrow(string col) => sortBy == col ? (sortDir == "asc" ? " ▲" : " ▼") : "";
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";
    Dictionary<string, string?> Route(string? sb, string? sd) => new()
    {
        ["stage"] = f.Stage?.ToString(),
        ["from"] = D(f.From), ["to"] = D(f.To), ["search"] = f.Search,
        ["sortBy"] = sb, ["sortDir"] = sd
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Opportunity Report</h1>
    <a asp-action="Opportunities" asp-all-route-data="@(Route(sortBy, sortDir))" asp-route-format="csv"
       class="btn btn-outline-success btn-sm"><i class="bi bi-download"></i> Export CSV</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Opportunities" class="row g-2 mb-3">
    <div class="col-md-3">
        <input name="search" value="@f.Search" class="form-control" placeholder="Search name, customer, source..." />
    </div>
    <div class="col-md-2">
        <select name="stage" class="form-select">
            <option value="">All stages</option>
            @foreach (var s in Enum.GetValues<OpportunityStage>())
            {
                <option value="@s" selected="@(f.Stage == s ? "selected" : null)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="from" value="@D(f.From)" class="form-control" title="From" />
    </div>
    <div class="col-md-2">
        <input type="date" name="to" value="@D(f.To)" class="form-control" title="To" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Opportunities" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th><a asp-action="Opportunities" asp-all-route-data="@(Route("name", ToggleDir("name")))" class="text-decoration-none">Name@(Arrow("name"))</a></th>
                <th>Customer</th>
                <th class="text-end"><a asp-action="Opportunities" asp-all-route-data="@(Route("amount", ToggleDir("amount")))" class="text-decoration-none">Amount@(Arrow("amount"))</a></th>
                <th><a asp-action="Opportunities" asp-all-route-data="@(Route("stage", ToggleDir("stage")))" class="text-decoration-none">Stage@(Arrow("stage"))</a></th>
                <th class="text-end"><a asp-action="Opportunities" asp-all-route-data="@(Route("probability", ToggleDir("probability")))" class="text-decoration-none">Prob.@(Arrow("probability"))</a></th>
                <th class="text-end"><a asp-action="Opportunities" asp-all-route-data="@(Route("weighted", ToggleDir("weighted")))" class="text-decoration-none">Weighted@(Arrow("weighted"))</a></th>
                <th><a asp-action="Opportunities" asp-all-route-data="@(Route("close", ToggleDir("close")))" class="text-decoration-none">Exp. Close@(Arrow("close"))</a></th>
                <th>Assigned To</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No opportunities match the current filters.</td></tr>
            }
            @foreach (var o in Model.Items)
            {
                <tr>
                    <td>@o.OpportunityName</td>
                    <td>@(o.CustomerName ?? "-")</td>
                    <td class="text-end text-nowrap">₹@o.Amount.ToString("N2")</td>
                    <td><span class="badge bg-secondary">@o.Stage</span></td>
                    <td class="text-end">@o.Probability%</td>
                    <td class="text-end text-nowrap">₹@o.WeightedAmount.ToString("N2")</td>
                    <td class="text-nowrap">@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                    <td>@(o.AssignedToName ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel
{
    PageIndex = Model.Page,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "Opportunities",
    Controller = "Reports",
    RouteValues = Route(sortBy, sortDir)
})
