@using AcxiomCRM.Web.Services
@model PipelineReportResult
@{
    ViewData["Title"] = "Pipeline Report";
    var f = (PipelineReportFilters)(ViewBag.Filters ?? new PipelineReportFilters());
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pipeline Report</h1>
    <a asp-action="Pipeline" asp-route-from="@D(f.From)" asp-route-to="@D(f.To)" asp-route-format="csv"
       class="btn btn-outline-success btn-sm"><i class="bi bi-download"></i> Export CSV</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Pipeline" class="row g-2 mb-3">
    <div class="col-md-2">
        <input type="date" name="from" value="@D(f.From)" class="form-control" title="From (created)" />
    </div>
    <div class="col-md-2">
        <input type="date" name="to" value="@D(f.To)" class="form-control" title="To (created)" />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Pipeline" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Opportunities</div>
            <div class="h4 mb-0">@Model.TotalCount</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Total Pipeline Value</div>
            <div class="h4 mb-0">₹@Model.GrandTotalAmount.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Weighted Pipeline Value</div>
            <div class="h4 mb-0">₹@Model.GrandTotalWeighted.ToString("N2")</div>
        </div></div>
    </div>
</div>

<h2 class="h5">Stage-wise pipeline</h2>
<div class="table-responsive mb-4">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr><th>Stage</th><th class="text-end">Count</th><th class="text-end">Total Amount</th><th class="text-end">Weighted Amount</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Stages)
            {
                <tr>
                    <td><span class="badge bg-secondary">@s.Stage</span></td>
                    <td class="text-end">@s.Count</td>
                    <td class="text-end text-nowrap">₹@s.TotalAmount.ToString("N2")</td>
                    <td class="text-end text-nowrap">₹@s.WeightedAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light">
            <tr>
                <th>Total</th>
                <th class="text-end">@Model.TotalCount</th>
                <th class="text-end text-nowrap">₹@Model.GrandTotalAmount.ToString("N2")</th>
                <th class="text-end text-nowrap">₹@Model.GrandTotalWeighted.ToString("N2")</th>
            </tr>
        </tfoot>
    </table>
</div>

<h2 class="h5">Owner-wise pipeline</h2>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr><th>Owner</th><th class="text-end">Count</th><th class="text-end">Total Amount</th><th class="text-end">Weighted Amount</th></tr>
        </thead>
        <tbody>
            @if (!Model.ByOwner.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No opportunities match the current filters.</td></tr>
            }
            @foreach (var o in Model.ByOwner)
            {
                <tr>
                    <td>@o.OwnerName</td>
                    <td class="text-end">@o.Count</td>
                    <td class="text-end text-nowrap">₹@o.TotalAmount.ToString("N2")</td>
                    <td class="text-end text-nowrap">₹@o.WeightedAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
