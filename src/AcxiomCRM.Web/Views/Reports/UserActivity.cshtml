@using AcxiomCRM.Web.Models
@using AcxiomCRM.Web.Services
@using AcxiomCRM.Web.ViewModels.Shared
@model PagedResult<UserActivityReportRow>
@{
    ViewData["Title"] = "User Activity Report";
    var f = (UserActivityReportFilters)(ViewBag.Filters ?? new UserActivityReportFilters());
    var sortBy = f.SortBy ?? "total";
    var sortDir = f.SortDir ?? "desc";
    var showUserFilter = (bool)(ViewBag.ShowUserFilter ?? false);
    var filterUsers = (List<ApplicationUser>?)(ViewBag.FilterUsers);
    string ToggleDir(string col) => sortBy == col && sortDir == "asc" ? "desc" : "asc";
    string Arrow(string col) => sortBy == col ? (sortDir == "asc" ? " ▲" : " ▼") : "";
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";
    Dictionary<string, string?> Route(string? sb, string? sd) => new()
    {
        ["userId"] = f.UserId,
        ["from"] = D(f.From), ["to"] = D(f.To),
        ["sortBy"] = sb, ["sortDir"] = sd
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">User Activity Report</h1>
    <a asp-action="UserActivity" asp-all-route-data="@(Route(sortBy, sortDir))" asp-route-format="csv"
       class="btn btn-outline-success btn-sm"><i class="bi bi-download"></i> Export CSV</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="UserActivity" class="row g-2 mb-3">
    @if (showUserFilter && filterUsers is not null)
    {
        <div class="col-md-3">
            <select name="userId" class="form-select">
                <option value="">All users</option>
                @foreach (var u in filterUsers)
                {
                    <option value="@u.Id" selected="@(f.UserId == u.Id ? "selected" : null)">@u.FullName</option>
                }
            </select>
        </div>
    }
    <div class="col-md-2">
        <input type="date" name="from" value="@D(f.From)" class="form-control" title="From" />
    </div>
    <div class="col-md-2">
        <input type="date" name="to" value="@D(f.To)" class="form-control" title="To" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="UserActivity" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th><a asp-action="UserActivity" asp-all-route-data="@(Route("user", ToggleDir("user")))" class="text-decoration-none">User@(Arrow("user"))</a></th>
                <th class="text-end"><a asp-action="UserActivity" asp-all-route-data="@(Route("logins", ToggleDir("logins")))" class="text-decoration-none">Logins@(Arrow("logins"))</a></th>
                <th class="text-end"><a asp-action="UserActivity" asp-all-route-data="@(Route("creates", ToggleDir("creates")))" class="text-decoration-none">Creates@(Arrow("creates"))</a></th>
                <th class="text-end"><a asp-action="UserActivity" asp-all-route-data="@(Route("updates", ToggleDir("updates")))" class="text-decoration-none">Updates@(Arrow("updates"))</a></th>
                <th class="text-end"><a asp-action="UserActivity" asp-all-route-data="@(Route("deletes", ToggleDir("deletes")))" class="text-decoration-none">Deletes@(Arrow("deletes"))</a></th>
                <th class="text-end"><a asp-action="UserActivity" asp-all-route-data="@(Route("exports", ToggleDir("exports")))" class="text-decoration-none">Exports@(Arrow("exports"))</a></th>
                <th class="text-end"><a asp-action="UserActivity" asp-all-route-data="@(Route("total", ToggleDir("total")))" class="text-decoration-none">Total@(Arrow("total"))</a></th>
                <th><a asp-action="UserActivity" asp-all-route-data="@(Route("last", ToggleDir("last")))" class="text-decoration-none">Last Activity@(Arrow("last"))</a></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No activity found for the current filters.</td></tr>
            }
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td>@r.FullName <span class="text-muted small">(@r.UserName)</span></td>
                    <td class="text-end">@r.Logins</td>
                    <td class="text-end">@r.Creates</td>
                    <td class="text-end">@r.Updates</td>
                    <td class="text-end">@r.Deletes</td>
                    <td class="text-end">@r.Exports</td>
                    <td class="text-end fw-bold">@r.Total</td>
                    <td class="text-nowrap">@(r.LastActivity?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel
{
    PageIndex = Model.Page,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "UserActivity",
    Controller = "Reports",
    RouteValues = Route(sortBy, sortDir)
})
