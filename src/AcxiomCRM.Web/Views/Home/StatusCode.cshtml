@{
    var code = (int)(ViewData["StatusCode"] ?? 500);
    var titles = new Dictionary<int, string>
    {
        [400] = "Bad Request",
        [401] = "Unauthorized",
        [403] = "Access Denied",
        [404] = "Page Not Found",
        [500] = "Something Went Wrong"
    };
    var messages = new Dictionary<int, string>
    {
        [400] = "The request could not be understood. Please try again.",
        [401] = "You need to sign in to access this page.",
        [403] = "You do not have permission to access this page.",
        [404] = "The page you are looking for does not exist.",
        [500] = "An unexpected error occurred. Our team has been notified."
    };
    ViewData["Title"] = $"{code} — {(titles.TryGetValue(code, out var t) ? t : "Error")}";
    Layout = "_Layout";
}
<div class="container py-5 text-center">
    <h1 class="display-1 fw-bold text-primary">@code</h1>
    <h2 class="mb-3">@(titles.TryGetValue(code, out var title) ? title : "Error")</h2>
    <p class="text-muted mb-4">@(messages.TryGetValue(code, out var msg) ? msg : "An error occurred.")</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
</div>
