@model AcxiomCRM.Web.ViewModels.Leads.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<h1 class="h3 mb-3">Convert Lead to Customer</h1>

<partial name="_Alerts" />

<div class="alert alert-info">
    Converting lead <strong>@Model.LeadName</strong> (<code>@Model.LeadCode</code>) will create a new customer
    (details copied from the lead) and mark the lead as <strong>Converted</strong>. Optionally, an opportunity
    can be created and linked to both.
</div>

<form asp-action="Convert" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="LeadId" />
    <input type="hidden" asp-for="LeadCode" />
    <input type="hidden" asp-for="LeadName" />

    <div class="form-check mb-3">
        <input asp-for="CreateOpportunity" class="form-check-input" id="createOppCheck" />
        <label asp-for="CreateOpportunity" class="form-check-label"></label>
    </div>

    <fieldset id="opportunityFields" class="row g-3 border rounded p-3 mb-3">
        <legend class="float-none w-auto px-2 fs-6">Opportunity details</legend>
        <div class="col-md-6">
            <label asp-for="OpportunityName" class="form-label"></label>
            <input asp-for="OpportunityName" class="form-control" />
            <span asp-validation-for="OpportunityName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OpportunityAmount" class="form-label"></label>
            <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="OpportunityAmount" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Probability" class="form-label"></label>
            <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
            <span asp-validation-for="Probability" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ExpectedCloseDate" class="form-label"></label>
            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
            <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
        </div>
    </fieldset>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Convert Lead</button>
        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var check = document.getElementById('createOppCheck');
            var fields = document.getElementById('opportunityFields');
            function toggle() {
                var enabled = check.checked;
                fields.style.opacity = enabled ? '1' : '0.5';
                fields.querySelectorAll('input, select, textarea').forEach(function (el) {
                    el.disabled = !enabled;
                });
            }
            check.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
