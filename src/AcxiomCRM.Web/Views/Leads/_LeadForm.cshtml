@model AcxiomCRM.Web.ViewModels.Leads.LeadFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="LeadName" class="form-label"></label>
        <input asp-for="LeadName" class="form-control" />
        <span asp-validation-for="LeadName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" placeholder="10-digit Indian mobile" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Source" class="form-label"></label>
        <input asp-for="Source" class="form-control" placeholder="e.g. Website, Referral" />
        <span asp-validation-for="Source" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" class="form-select">
            @foreach (var p in Enum.GetValues<LeadPriority>())
            {
                <option value="@p">@p</option>
            }
        </select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ExpectedValue" class="form-label"></label>
        <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="ExpectedValue" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
</div>
