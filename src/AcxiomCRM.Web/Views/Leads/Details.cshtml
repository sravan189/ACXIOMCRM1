@model Lead
@using AcxiomCRM.Web.Services
@{
    ViewData["Title"] = "Lead Details";
    var opportunities = (List<Opportunity>?)ViewBag.Opportunities ?? new List<Opportunity>();
    var nextStatuses = LeadStatusTransitions.GetAllowed(Model.Status);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.LeadName <small class="text-muted fs-6"><code>@Model.LeadCode</code></small></h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary">Edit</a>
        <a asp-action="Assign" asp-route-id="@Model.LeadId" class="btn btn-outline-primary">Assign</a>
        @if (Model.Status == LeadStatus.Qualified)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success">Convert</a>
        }
        <a asp-action="Delete" asp-route-id="@Model.LeadId" class="btn btn-outline-danger">Delete</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<partial name="_Alerts" />

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="card-title mb-0">Lead Information</h5>
            <span class="badge @LeadStatusBadge(Model.Status) fs-6">@Model.Status</span>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@(Model.CompanyName ?? "—")</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "—")</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
            <dt class="col-sm-3">Source</dt>
            <dd class="col-sm-9">@(Model.Source ?? "—")</dd>
            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9"><span class="badge @LeadPriorityBadge(Model.Priority)">@Model.Priority</span></dd>
            <dt class="col-sm-3">Expected Value</dt>
            <dd class="col-sm-9">₹@Model.ExpectedValue.ToString("N2")</dd>
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(Model.Notes ?? "—")</dd>
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@(Model.CreatedBy?.FullName ?? "—")</dd>
            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">@(Model.AssignedTo?.FullName ?? "—")</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">Change Status</h5></div>
    <div class="card-body">
        @if (nextStatuses.Any())
        {
            <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label for="newStatus" class="form-label">New status</label>
                    <select name="newStatus" id="newStatus" class="form-select">
                        @foreach (var s in nextStatuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-primary">Change Status</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted mb-0">This lead is in a terminal status (@Model.Status) and cannot be changed.</p>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">Opportunities (@opportunities.Count)</h5></div>
    <div class="card-body p-0">
        @if (opportunities.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Amount</th><th>Stage</th><th>Probability</th><th>Expected Close</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in opportunities)
                        {
                            <tr>
                                <td>@o.OpportunityName</td>
                                <td class="text-nowrap">₹@o.Amount.ToString("N2")</td>
                                <td><span class="badge bg-info text-dark">@o.Stage</span></td>
                                <td>@o.Probability%</td>
                                <td class="text-nowrap">@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted p-3 mb-0">No opportunities linked to this lead.</p>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">Follow-ups (@Model.FollowUps.Count)</h5></div>
    <div class="card-body p-0">
        @if (Model.FollowUps.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr><th>Date</th><th>Type</th><th>Remarks</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps.OrderByDescending(f => f.FollowUpDate))
                        {
                            <tr>
                                <td class="text-nowrap">@f.FollowUpDate.ToString("dd MMM yyyy")</td>
                                <td>@f.FollowUpType</td>
                                <td>@(f.Remarks ?? "—")</td>
                                <td><span class="badge bg-secondary">@f.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted p-3 mb-0">No follow-ups for this lead.</p>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">Activities (@Model.Activities.Count)</h5></div>
    <div class="card-body p-0">
        @if (Model.Activities.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr><th>Date</th><th>Type</th><th>Subject</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Activities.OrderByDescending(a => a.ActivityDate))
                        {
                            <tr>
                                <td class="text-nowrap">@a.ActivityDate.ToString("dd MMM yyyy")</td>
                                <td>@a.ActivityType</td>
                                <td>@a.Subject</td>
                                <td><span class="badge bg-secondary">@a.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted p-3 mb-0">No activities for this lead.</p>
        }
    </div>
</div>

@functions {
    string LeadStatusBadge(LeadStatus s) => s switch
    {
        LeadStatus.New => "bg-primary",
        LeadStatus.Contacted => "bg-info text-dark",
        LeadStatus.Qualified => "bg-success",
        LeadStatus.Converted => "bg-dark",
        LeadStatus.Lost => "bg-danger",
        _ => "bg-secondary",
    };
    string LeadPriorityBadge(LeadPriority p) => p switch
    {
        LeadPriority.High => "bg-danger",
        LeadPriority.Medium => "bg-warning text-dark",
        _ => "bg-secondary",
    };
}
