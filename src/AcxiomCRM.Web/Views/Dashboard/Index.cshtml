@model AcxiomCRM.Web.ViewModels.Dashboard.DashboardViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var inr = CultureInfo.GetCultureInfo("en-IN");
    string Money(decimal v) => "₹" + v.ToString("N0", inr);
    string DateVal(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>

    <!-- Date filter -->
    <form id="dateFilterForm" asp-controller="Dashboard" asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2">
        <div>
            <label for="from" class="form-label small mb-0">From</label>
            <input type="date" id="from" name="from" class="form-control form-control-sm" value="@DateVal(Model.From)" />
        </div>
        <div>
            <label for="to" class="form-label small mb-0">To</label>
            <input type="date" id="to" name="to" class="form-control form-control-sm" value="@DateVal(Model.To)" />
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="Date presets">
            <button type="button" class="btn btn-outline-secondary" data-range-preset="today">Today</button>
            <button type="button" class="btn btn-outline-secondary" data-range-preset="week">This Week</button>
            <button type="button" class="btn btn-outline-secondary" data-range-preset="month">This Month</button>
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Apply</button>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
    </form>
</div>

<!-- ============ KPI CARDS ============ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card kpi-blue h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon"><i class="bi bi-people"></i></div>
                <div>
                    <div class="kpi-label">Customers</div>
                    <div class="kpi-value">@Model.TotalCustomers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card kpi-teal h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon"><i class="bi bi-funnel"></i></div>
                <div>
                    <div class="kpi-label">Total Leads</div>
                    <div class="kpi-value">@Model.TotalLeads</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card kpi-amber h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="kpi-label">Open Leads</div>
                    <div class="kpi-value">@Model.OpenLeads</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card kpi-indigo h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon"><i class="bi bi-briefcase"></i></div>
                <div>
                    <div class="kpi-label">Opportunities</div>
                    <div class="kpi-value">@Model.TotalOpportunities</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card kpi-orange h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon"><i class="bi bi-kanban"></i></div>
                <div>
                    <div class="kpi-label">Open Opportunities</div>
                    <div class="kpi-value">@Model.OpenOpportunities</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card kpi-green h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon"><i class="bi bi-trophy"></i></div>
                <div>
                    <div class="kpi-label">Won</div>
                    <div class="kpi-value">@Model.WonOpportunities</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card kpi-red h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon"><i class="bi bi-x-circle"></i></div>
                <div>
                    <div class="kpi-label">Lost</div>
                    <div class="kpi-value">@Model.LostOpportunities</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card kpi-slate h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="kpi-label">Pipeline Value</div>
                    <div class="kpi-value">@Money(Model.TotalPipelineValue)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============ CHARTS ============ -->
<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="card chart-card h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-pie-chart me-2"></i>Leads by Status</div>
            <div class="card-body">
                <div class="chart-wrap">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-8">
        <div class="card chart-card h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-bar-chart me-2"></i>Opportunity Pipeline by Stage</div>
            <div class="card-body">
                <div class="chart-wrap">
                    <canvas id="pipelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card chart-card">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-graph-up me-2"></i>Monthly Sales — Won Opportunities (Last 6 Months)</div>
            <div class="card-body">
                <div class="chart-wrap">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';
    if (typeof Chart === 'undefined') return;

    var leadLabels = @Html.Raw(JsonSerializer.Serialize(Model.LeadStatusCounts.Keys));
    var leadValues = @Html.Raw(JsonSerializer.Serialize(Model.LeadStatusCounts.Values));
    var stageLabels = @Html.Raw(JsonSerializer.Serialize(Model.OpportunityStageAmounts.Keys));
    var stageValues = @Html.Raw(JsonSerializer.Serialize(Model.OpportunityStageAmounts.Values));
    var salesLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales.Select(m => m.Month)));
    var salesValues = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales.Select(m => m.Total)));

    var inr = function (v) { return '₹' + Number(v).toLocaleString('en-IN', { maximumFractionDigits: 0 }); };

    // 1) Lead status — doughnut
    new Chart(document.getElementById('leadStatusChart'), {
        type: 'doughnut',
        data: {
            labels: leadLabels,
            datasets: [{
                data: leadValues,
                backgroundColor: ['#0d6efd', '#0dcaf0', '#198754', '#6c757d', '#ffc107', '#dc3545'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } }
        }
    });

    // 2) Opportunity pipeline by stage — bar (amounts)
    new Chart(document.getElementById('pipelineChart'), {
        type: 'bar',
        data: {
            labels: stageLabels,
            datasets: [{
                label: 'Amount',
                data: stageValues,
                backgroundColor: '#0d6efd',
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: function (c) { return inr(c.parsed.y); } } }
            },
            scales: {
                y: { beginAtZero: true, ticks: { callback: function (v) { return inr(v); } } }
            }
        }
    });

    // 3) Monthly sales — line (won opportunity totals)
    new Chart(document.getElementById('salesChart'), {
        type: 'line',
        data: {
            labels: salesLabels,
            datasets: [{
                label: 'Won amount',
                data: salesValues,
                borderColor: '#198754',
                backgroundColor: 'rgba(25, 135, 84, 0.12)',
                fill: true,
                tension: 0.3,
                pointRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                tooltip: { callbacks: { label: function (c) { return inr(c.parsed.y); } } }
            },
            scales: {
                y: { beginAtZero: true, ticks: { callback: function (v) { return inr(v); } } }
            }
        }
    });
})();
</script>
}
