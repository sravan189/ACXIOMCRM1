@model AcxiomCRM.Web.Helpers.PaginatedList<AcxiomCRM.Web.Models.Opportunity>
@using AcxiomCRM.Web.Models
@using AcxiomCRM.Web.ViewModels.Shared
@{
    ViewData["Title"] = "Opportunities";
    var search = ViewBag.Search as string;
    var stage = ViewBag.Stage as OpportunityStage?;
}

@functions {
    string StageBadge(OpportunityStage s) => s switch
    {
        OpportunityStage.Qualification => "secondary",
        OpportunityStage.Proposal => "info",
        OpportunityStage.Negotiation => "warning",
        OpportunityStage.Won => "success",
        OpportunityStage.Lost => "danger",
        _ => "secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Opportunities</h2>
    <div>
        <a asp-action="Pipeline" class="btn btn-outline-secondary me-2">
            <i class="bi bi-kanban me-1"></i>Pipeline
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>New Opportunity
        </a>
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name or company..." />
    </div>
    <div class="col-md-3">
        <select name="stage" class="form-select">
            <option value="">All stages</option>
            @foreach (var st in Enum.GetValues<OpportunityStage>())
            {
                if (stage.HasValue && stage.Value == st)
                {
                    <option value="@st" selected>@st</option>
                }
                else
                {
                    <option value="@st">@st</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Customer</th>
                <th class="text-end">Amount</th>
                <th class="text-end">Prob.</th>
                <th class="text-end">Weighted</th>
                <th>Stage</th>
                <th>Close Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@o.OpportunityId">@o.OpportunityName</a></td>
                    <td>@(o.Customer?.CompanyName ?? o.Customer?.CustomerName ?? "-")</td>
                    <td class="text-end">&#8377;@o.Amount.ToString("N2")</td>
                    <td class="text-end">@o.Probability%</td>
                    <td class="text-end">&#8377;@o.WeightedAmount.ToString("N2")</td>
                    <td><span class="badge bg-@StageBadge(o.Stage)">@o.Stage</span></td>
                    <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@o.OpportunityId" class="btn btn-outline-danger"
                               data-confirm="Delete this opportunity?">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel
{
    PageIndex = Model.PageIndex,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "Index",
    Controller = "Opportunities",
    RouteValues = new Dictionary<string, string?>
    {
        ["search"] = search,
        ["stage"] = stage?.ToString()
    }
})
