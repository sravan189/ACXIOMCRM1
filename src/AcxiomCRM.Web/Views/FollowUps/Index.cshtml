@model AcxiomCRM.Web.Helpers.PaginatedList<AcxiomCRM.Web.Models.FollowUp>
@using AcxiomCRM.Web.Models
@using AcxiomCRM.Web.ViewModels.Shared
@{
    ViewData["Title"] = "Follow-ups";
    var filter = (ViewBag.Filter as string) ?? "upcoming";
    var search = ViewBag.Search as string;
    var assignedTo = ViewBag.AssignedTo as string;
    var assignees = ViewBag.Assignees as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

@functions {
    string StatusBadge(FollowUpStatus s) => s switch
    {
        FollowUpStatus.Planned => "primary",
        FollowUpStatus.Completed => "success",
        FollowUpStatus.Missed => "warning",
        FollowUpStatus.Cancelled => "secondary",
        _ => "secondary"
    };
    string TabClass(string name, string current) => name == current ? "active" : "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Follow-ups</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Schedule Follow-up
    </a>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @TabClass("upcoming", filter)" asp-action="Index" asp-route-status="upcoming">
            <i class="bi bi-calendar-event me-1"></i>Upcoming
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @TabClass("overdue", filter)" asp-action="Index" asp-route-status="overdue">
            <i class="bi bi-alarm me-1"></i>Overdue
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @TabClass("completed", filter)" asp-action="Index" asp-route-status="completed">
            <i class="bi bi-check2-circle me-1"></i>Completed
        </a>
    </li>
</ul>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <input type="hidden" name="status" value="@filter" />
    <div class="col-md-5">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search remarks or company..." />
    </div>
    @if (assignees is not null)
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select">
                <option value="">All assignees</option>
                @foreach (var a in assignees)
                {
                    if (a.Value == assignedTo)
                    {
                        <option value="@a.Value" selected>@a.Text</option>
                    }
                    else
                    {
                        <option value="@a.Value">@a.Text</option>
                    }
                }
            </select>
        </div>
    }
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" asp-route-status="@filter" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Remarks</th>
                <th>Related To</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model)
            {
                <tr class="@(f.IsOverdue ? "table-danger" : "")">
                    <td>
                        <a asp-action="Details" asp-route-id="@f.FollowUpId">@f.FollowUpDate.ToString("dd MMM yyyy")</a>
                        @if (f.IsOverdue)
                        {
                            <span class="badge bg-danger ms-1">Overdue</span>
                        }
                    </td>
                    <td><span class="badge bg-info text-dark">@f.FollowUpType</span></td>
                    <td>@(string.IsNullOrWhiteSpace(f.Remarks) ? "-" : (f.Remarks.Length > 60 ? f.Remarks[..60] + "..." : f.Remarks))</td>
                    <td>@(f.Customer?.CompanyName ?? f.Customer?.CustomerName ?? f.Lead?.CompanyName ?? f.Lead?.LeadName ?? "-")</td>
                    <td><span class="badge bg-@StatusBadge(f.Status)">@f.Status</span></td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            @if (f.Status == FollowUpStatus.Planned || f.Status == FollowUpStatus.Missed)
                            {
                                <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-success btn-sm">Complete</button>
                                </form>
                            }
                            <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@f.FollowUpId" class="btn btn-outline-danger"
                               data-confirm="Delete this follow-up?">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel
{
    PageIndex = Model.PageIndex,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "Index",
    Controller = "FollowUps",
    RouteValues = new Dictionary<string, string?>
    {
        ["status"] = filter,
        ["search"] = search,
        ["assignedTo"] = assignedTo
    }
})
