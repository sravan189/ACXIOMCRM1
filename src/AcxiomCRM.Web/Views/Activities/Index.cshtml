@model AcxiomCRM.Web.Helpers.PaginatedList<AcxiomCRM.Web.Models.Activity>
@using AcxiomCRM.Web.Models
@using AcxiomCRM.Web.ViewModels.Shared
@{
    ViewData["Title"] = "Activities";
    var search = ViewBag.Search as string;
    var type = ViewBag.Type as ActivityType?;
    var status = ViewBag.Status as ActivityStatus?;
}

@functions {
    string TypeBadge(ActivityType t) => t switch
    {
        ActivityType.Call => "primary",
        ActivityType.Meeting => "info",
        ActivityType.Email => "secondary",
        ActivityType.Task => "warning",
        _ => "secondary"
    };
    string StatusBadge(ActivityStatus s) => s switch
    {
        ActivityStatus.Planned => "primary",
        ActivityStatus.Completed => "success",
        ActivityStatus.Cancelled => "secondary",
        _ => "secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Activities</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Log Activity
    </a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search subject or description..." />
    </div>
    <div class="col-md-2">
        <select name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var t in Enum.GetValues<ActivityType>())
            {
                if (type.HasValue && type.Value == t)
                {
                    <option value="@t" selected>@t</option>
                }
                else
                {
                    <option value="@t">@t</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<ActivityStatus>())
            {
                if (status.HasValue && status.Value == s)
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Subject</th>
                <th>Related To</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.ActivityDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge bg-@TypeBadge(a.ActivityType)">@a.ActivityType</span></td>
                    <td><a asp-action="Details" asp-route-id="@a.ActivityId">@a.Subject</a></td>
                    <td>@(a.Customer?.CompanyName ?? a.Customer?.CustomerName ?? a.Lead?.CompanyName ?? a.Lead?.LeadName ?? "-")</td>
                    <td><span class="badge bg-@StatusBadge(a.Status)">@a.Status</span></td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@a.ActivityId" class="btn btn-outline-danger"
                               data-confirm="Delete this activity?">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel
{
    PageIndex = Model.PageIndex,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "Index",
    Controller = "Activities",
    RouteValues = new Dictionary<string, string?>
    {
        ["search"] = search,
        ["type"] = type?.ToString(),
        ["status"] = status?.ToString()
    }
})
