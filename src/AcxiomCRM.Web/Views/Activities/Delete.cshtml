@model AcxiomCRM.Web.Models.Activity
@{
    ViewData["Title"] = "Delete Activity";
}

<h2>Delete Activity</h2>
<hr />

<div class="alert alert-warning" role="alert">
    Are you sure you want to delete the activity
    <strong>@Model.Subject</strong>
    (@Model.ActivityType, @Model.ActivityDate.ToString("dd MMM yyyy"))?
    This cannot be undone.
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.ActivityId" />
    <button type="submit" class="btn btn-danger" data-confirm="Permanently delete this activity?">Delete</button>
    <a asp-action="Details" asp-route-id="@Model.ActivityId" class="btn btn-link">Cancel</a>
</form>
