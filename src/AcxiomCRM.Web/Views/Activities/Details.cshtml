@model AcxiomCRM.Web.Models.Activity
@using AcxiomCRM.Web.Models
@{
    ViewData["Title"] = "Activity details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Subject</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.ActivityId" class="btn btn-outline-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.ActivityId" class="btn btn-outline-danger"
           data-confirm="Delete this activity?">Delete</a>
        <a asp-action="Index" class="btn btn-link">Back to list</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Activity Type</dt>
            <dd class="col-sm-9">@Model.ActivityType</dd>

            <dt class="col-sm-3">Activity Date</dt>
            <dd class="col-sm-9">@Model.ActivityDate.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@(Model.Customer?.CompanyName ?? Model.Customer?.CustomerName ?? "-")</dd>

            <dt class="col-sm-3">Lead</dt>
            <dd class="col-sm-9">@(Model.Lead?.CompanyName ?? Model.Lead?.LeadName ?? "-")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "-")</dd>
        </dl>
    </div>
</div>
