@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";

    string Active(string controller, string? action = null)
    {
        var c = ViewContext.RouteData.Values["controller"]?.ToString();
        var a = ViewContext.RouteData.Values["action"]?.ToString();
        if (!string.Equals(c, controller, StringComparison.OrdinalIgnoreCase)) return "";
        if (action is not null && !string.Equals(a, action, StringComparison.OrdinalIgnoreCase)) return "";
        return "active";
    }

    string ActiveController(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuthenticated)
    {
        <!-- ============ TOP NAVBAR ============ -->
        <header>
            <nav class="navbar navbar-expand navbar-dark bg-primary fixed-top shadow-sm">
                <div class="container-fluid">
                    <button class="btn btn-outline-light d-lg-none me-2" id="sidebarToggle" type="button"
                            aria-label="Toggle navigation">
                        <i class="bi bi-list"></i>
                    </button>
                    <a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-lightning-charge-fill me-1"></i>AcxiomCRM
                    </a>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="userMenu"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>@displayName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                <li>
                                    <span class="dropdown-item-text text-muted small">
                                        Signed in as<br /><strong class="text-dark">@displayName</strong>
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        <!-- ============ SIDEBAR ============ -->
        <nav id="sidebar" class="sidebar" aria-label="Primary">
            <div class="sidebar-inner">
                <a class="sidebar-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                </a>

                <div class="sidebar-heading">Customers</div>
                <a class="sidebar-link @Active("Customers", "Index")" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i><span>All Customers</span>
                </a>
                <a class="sidebar-link @Active("Customers", "Create")" asp-controller="Customers" asp-action="Create">
                    <i class="bi bi-person-plus"></i><span>Add Customer</span>
                </a>

                <div class="sidebar-heading">Leads</div>
                <a class="sidebar-link @Active("Leads", "Index")" asp-controller="Leads" asp-action="Index">
                    <i class="bi bi-funnel"></i><span>All Leads</span>
                </a>
                <a class="sidebar-link @Active("Leads", "Create")" asp-controller="Leads" asp-action="Create">
                    <i class="bi bi-plus-circle"></i><span>Add Lead</span>
                </a>

                <div class="sidebar-heading">Opportunities</div>
                <a class="sidebar-link @Active("Opportunities", "Index")" asp-controller="Opportunities" asp-action="Index">
                    <i class="bi bi-briefcase"></i><span>All Opportunities</span>
                </a>
                <a class="sidebar-link @Active("Opportunities", "Create")" asp-controller="Opportunities" asp-action="Create">
                    <i class="bi bi-plus-circle"></i><span>Add Opportunity</span>
                </a>
                <a class="sidebar-link @Active("Opportunities", "Pipeline")" asp-controller="Opportunities" asp-action="Pipeline">
                    <i class="bi bi-kanban"></i><span>Pipeline</span>
                </a>

                <div class="sidebar-heading">Follow-Ups</div>
                <a class="sidebar-link @ActiveController("FollowUps")" asp-controller="FollowUps" asp-action="Index" asp-route-status="Upcoming">
                    <i class="bi bi-calendar-event"></i><span>Upcoming</span>
                </a>
                <a class="sidebar-link" asp-controller="FollowUps" asp-action="Index" asp-route-status="Overdue">
                    <i class="bi bi-alarm"></i><span>Overdue</span>
                </a>
                <a class="sidebar-link" asp-controller="FollowUps" asp-action="Index" asp-route-status="Completed">
                    <i class="bi bi-check2-circle"></i><span>Completed</span>
                </a>

                <div class="sidebar-heading">Work</div>
                <a class="sidebar-link @Active("Activities")" asp-controller="Activities" asp-action="Index">
                    <i class="bi bi-activity"></i><span>Activities</span>
                </a>
                <a class="sidebar-link @Active("Reports")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart"></i><span>Reports</span>
                </a>

                @if (User.IsInRole(RoleNames.Admin))
                {
                    <div class="sidebar-heading">Administration</div>
                    <a class="sidebar-link @Active("Users")" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-person-gear"></i><span>Users</span>
                    </a>
                    <a class="sidebar-link @Active("Roles")" asp-controller="Roles" asp-action="Index">
                        <i class="bi bi-shield-lock"></i><span>Roles</span>
                    </a>
                    <a class="sidebar-link @Active("AuditLogs")" asp-controller="AuditLogs" asp-action="Index">
                        <i class="bi bi-journal-text"></i><span>Audit Logs</span>
                    </a>
                }
            </div>
        </nav>

        <div class="sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>
    }

    <!-- ============ MAIN CONTENT ============ -->
    <main class="@(isAuthenticated ? "content" : "content-full")">
        <div class="container-fluid py-3">
            @if (TempData["Success"] is string success && !string.IsNullOrWhiteSpace(success))
            {
                <div class="alert alert-success alert-dismissible fade show auto-dismiss" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger alert-dismissible fade show auto-dismiss" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
