@model AcxiomCRM.Web.ViewModels.Shared.PaginationViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="@Model.RouteValues" asp-route-page="@(Model.PageIndex - 1)">Previous</a>
            </li>
            @foreach (var p in Model.PageNumbers)
            {
                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                    <a class="page-link"
                       asp-controller="@Model.Controller" asp-action="@Model.Action"
                       asp-all-route-data="@Model.RouteValues" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="@Model.RouteValues" asp-route-page="@(Model.PageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
    <span class="text-muted small ms-2">@Model.TotalCount record(s)</span>
}
else if (Model.TotalCount > 0)
{
    <span class="text-muted small">@Model.TotalCount record(s)</span>
}
